# Optional base for machine-local data. Relative paths resolve from the repository.
SATQUERY_LOCAL_DATA_ROOT=data/raw
DATASET_ROOT=data/raw/bigearthnet-v2-small-sample
FEATURES_ROOT=data/raw/croma-features
CROMA_SOURCE=data/raw/croma-official
CROMA_CHECKPOINT=data/raw/checkpoints/CROMA_base.pt

# Required only for the frozen single-image scene-description route.
# Point this to the separately acquired local AdaptLLM remote-sensing Qwen2-VL model directory.
SATQUERY_SCENE_DESCRIPTION_MODEL=data/raw/checkpoints/remote-sensing-Qwen2-VL-2B-Instruct
